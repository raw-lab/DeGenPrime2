# Copied to assets/.htaccess by scripts/build_web.sh.
# Serve WebAssembly with its own type so browsers can compile it while it downloads.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(wasm|woff2)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
